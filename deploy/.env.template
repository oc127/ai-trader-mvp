# ═══════════════════════════════════════════════════════════
# Trading System Environment Variables
# Copy to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════

# ── Hyperliquid ────────────────────────────────────────────
HL_WALLET_ADDRESS=
HL_PRIVATE_KEY=
HL_API_KEY=
# testnet | mainnet
HL_ENVIRONMENT=testnet

# ── Deribit ────────────────────────────────────────────────
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
# Set to true for testnet
DERIBIT_TESTNET=true

# ── Gate.io ────────────────────────────────────────────────
GATE_API_KEY=
GATE_API_SECRET=

# ── Polymarket ─────────────────────────────────────────────
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# ── Telegram Alerts ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SSL (set if behind SSL inspection proxy) ──────────────
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
