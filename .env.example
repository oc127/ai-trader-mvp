# Hyperliquid wallet private key (agent wallet, NOT main wallet)
HL_PRIVATE_KEY=
# Hyperliquid wallet address
HL_WALLET_ADDRESS=

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Environment: testnet or mainnet
ENVIRONMENT=testnet

# LLM Provider (default: anthropic)
# LLM_PROVIDER=anthropic        # anthropic / openai / deepseek / openrouter / custom
# LLM_API_KEY=                   # API key for the chosen provider
# LLM_MODEL=                     # Model name (auto-selected per provider if empty)
# LLM_BASE_URL=                  # Custom endpoint URL (required for 'custom' provider)
